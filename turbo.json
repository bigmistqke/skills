{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "CANON_ALLOY_JAR",
        "CANON_JAVA"
      ]
    },
    "@bigmistqke/canon#test": {
      "dependsOn": [
        "build",
        "@bigmistqke/canon-plugin-alloy#build"
      ],
      "env": [
        "CANON_ALLOY_JAR",
        "CANON_JAVA"
      ]
    },
    "@bigmistqke/canon-plugin-alloy#test": {
      "dependsOn": [
        "build",
        "@bigmistqke/canon#build",
        "@bigmistqke/canon-plugin-retext#build"
      ],
      "env": [
        "CANON_ALLOY_JAR",
        "CANON_JAVA"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/canon/CANON.md",
        "$TURBO_ROOT$/packages/naturalloy/CANON.md"
      ]
    }
  }
}
