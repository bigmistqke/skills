{
  "name": "bigmistqke-skills",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "turbo run build",
    "canon": "node scripts/canon.ts",
    "generate": "node scripts/kinds.ts",
    "test": "turbo run test && node scripts/kinds.ts --check && node scripts/graph.ts --check",
    "typecheck": "turbo run typecheck",
    "release": "pnpm -r publish",
    "lint:prose": "cd packages/canon && node src/cli.ts retext:lint ../../skills/canon/SKILL.md ../../skills/canon/writing-units.md ../../skills/canon/checker.md ../../skills/grill-with-canon/SKILL.md",
    "graph": "node scripts/graph.ts"
  },
  "devDependencies": {
    "@bigmistqke/canon": "workspace:*",
    "@bigmistqke/canon-plugin-alloy": "workspace:*",
    "@bigmistqke/canon-plugin-retext": "workspace:*",
    "turbo": "^2.11.7",
    "@bigmistqke/canon-plugin-pele": "workspace:*"
  }
}
