{
  "name": "@bigmistqke/parse-alloy",
  "version": "0.1.1",
  "description": "A parser for the whole syntax of Alloy 6: Alloy as a string in, a typed AST out, grouped exactly as the Alloy analyzer groups it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmistqke/skills.git",
    "directory": "packages/parse-alloy"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@bigmistqke/canon": "workspace:*",
    "@bigmistqke/canon-plugin-retext": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
