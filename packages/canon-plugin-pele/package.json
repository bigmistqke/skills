{
  "name": "@bigmistqke/canon-plugin-pele",
  "version": "0.1.1",
  "description": "The Pele plugin for @bigmistqke/canon: the derivations of a canon drawn as a graph, as Mermaid text or as an SVG that Pele renders.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmistqke/skills.git",
    "directory": "packages/canon-plugin-pele"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@bigmistqke/canon": "^0.5.0 || ^0.6.0"
  },
  "dependencies": {
    "pele": "1.6.0"
  },
  "devDependencies": {
    "@bigmistqke/canon": "workspace:*",
    "@bigmistqke/canon-plugin-retext": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
