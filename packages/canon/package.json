{
  "name": "@bigmistqke/canon",
  "version": "0.3.0",
  "description": "The checker for a project's canon: the derivation links between CANON.md, its tests and its code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmistqke/skills.git",
    "directory": "packages/canon"
  },
  "type": "module",
  "bin": {
    "canon": "./dist/cli.js"
  },
  "exports": {
    "./blocks": "./dist/blocks.js",
    "./extends": "./dist/extends.js",
    "./frontmatter": "./dist/frontmatter.js",
    "./kinds": "./dist/kinds.js",
    "./package.json": "./package.json",
    "./plugin": "./dist/plugin.js",
    "./regions": "./dist/regions.js",
    "./units": "./dist/units.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bump": "bumpp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bumpp": "^12.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "^1.0.13",
    "acorn": "^8.19.0"
  }
}
